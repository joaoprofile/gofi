{
  "name": "gofi-ai",
  "displayName": "GOFI AI",
  "description": "O gofi dentro do VSCode: o chat no terminal do editor, o grafo do projeto e a execução de uma entrega, desenhados.",
  "version": "0.8.0",
  "publisher": "gofi",
  "license": "MIT",
  "engines": {
    "vscode": "^1.84.0"
  },
  "categories": [
    "AI",
    "Visualization",
    "Other"
  ],
  "keywords": [
    "gofi",
    "claude",
    "chat",
    "agent",
    "sdd",
    "graph"
  ],
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#0B2B3A",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/joaoprofile/gofi"
  },
  "homepage": "https://github.com/joaoprofile/gofi",
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "gofi-ai.chatInTerminal",
        "title": "Chat in Terminal",
        "category": "GOFI",
        "icon": "images/gofi.svg"
      },
      {
        "command": "gofi-ai.mention",
        "title": "mencionar o arquivo aberto no chat",
        "category": "GOFI",
        "icon": "$(mention)"
      },
      {
        "command": "gofi-ai.chatTerminalPaste",
        "title": "colar no chat do terminal (texto ou imagem)",
        "category": "GOFI"
      },
      {
        "command": "gofi-ai.graph",
        "title": "grafo do projeto",
        "category": "GOFI",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "gofi-ai.docsBuild",
        "title": "construir o grafo de documentos",
        "category": "GOFI",
        "icon": "$(tools)"
      },
      {
        "command": "gofi-ai.run",
        "title": "execução de uma entrega (fluxo e rastreio)",
        "category": "GOFI",
        "icon": "$(git-pull-request)"
      },
      {
        "command": "gofi-ai.doctor",
        "title": "diagnosticar a instalação",
        "category": "GOFI"
      }
    ],
    "keybindings": [
      {
        "command": "workbench.action.terminal.sendSequence",
        "args": {
          "text": "\u001b\r"
        },
        "key": "shift+enter",
        "when": "terminalFocus && gofi-ai.chatTerminalFocus"
      },
      {
        "command": "gofi-ai.chatTerminalPaste",
        "key": "ctrl+v",
        "when": "terminalFocus && gofi-ai.chatTerminalFocus"
      },
      {
        "command": "gofi-ai.mention",
        "key": "ctrl+alt+g",
        "mac": "cmd+alt+g",
        "when": "editorTextFocus"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "gofi-ai.chatTerminalPaste",
          "when": "gofi-ai.chatTerminalFocus"
        }
      ],
      "editor/title": [
        {
          "command": "gofi-ai.chatInTerminal",
          "group": "navigation@100"
        },
        {
          "command": "gofi-ai.graph",
          "group": "navigation@101"
        }
      ],
      "editor/context": [
        {
          "command": "gofi-ai.mention",
          "group": "gofi@1"
        }
      ]
    },
    "configuration": {
      "title": "GOFI",
      "properties": {
        "gofiAI.gofiPath": {
          "type": "string",
          "default": "gofi",
          "markdownDescription": "Caminho do binário `gofi`. Vazio ou `gofi` usa o do PATH."
        },
        "gofiAI.model": {
          "type": "string",
          "default": "",
          "markdownDescription": "Modelo com que **GOFI: Chat in Terminal** abre o chat (ex.: `opus`, `sonnet`). Vazio usa o `ai.model` do `.gofi.yaml`."
        },
        "gofiAI.terminal.location": {
          "type": "string",
          "default": "beside",
          "enum": [
            "beside",
            "panel"
          ],
          "enumDescriptions": [
            "Numa aba do editor, ao lado do código — o padrão.",
            "No painel de terminais, embaixo."
          ],
          "markdownDescription": "Onde **GOFI: Chat in Terminal** abre o `gofi chat`."
        },
        "gofiAI.graph.openOnStartup": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Abre o grafo do projeto ao lado do código quando o workspace já tem `.gofi/index/docs/graph.json`. Desligado, ele abre pelo botão do grafo na barra do editor, ao lado do rosto do gofi."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "echo no-build",
    "package": "vsce package",
    "publish": "vsce publish",
    "test": "node test/project-model.test.js && node test/graph-layout.test.js && node test/run-view.test.js && node test/chat-terminal.test.js"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.0.0"
  }
}
