#!/bin/sh
# gofi-graph-rust: the code graph of a Rust tree, in gofi's extractor
# protocol. The program is the crate below — syn reads the code —, built
# with the project's own cargo into the user's cache, by its hash, the first
# time it runs; every run after runs the binary.
set -e
dir="${XDG_CACHE_HOME:-$HOME/.cache}/gofi/extractors/rust-ec4c8594701d"
bin="$dir/target/release/gofi-graph-rust"
if [ ! -x "$bin" ]; then
  mkdir -p "$dir/src"
  awk -v d="$dir" '
    /^__CARGO_TOML__$/ { f = d "/Cargo.toml"; next }
    /^__CARGO_LOCK__$/ { f = d "/Cargo.lock"; next }
    /^__MAIN_RS__$/    { f = d "/src/main.rs"; next }
    f != "" { print > f }
  ' "$0"
  cargo build --release --quiet --locked --manifest-path "$dir/Cargo.toml" >&2
fi
exec "$bin" "$@"
exit 0
__CARGO_TOML__
