__MAIN_RS__
//! gofi-graph-rust: the code graph of a Rust tree, in gofi's extractor
//! protocol (gofi-graph/v1), one JSON record a line on stdout.
//!
//! Reads each file with syn: modules, structs, enums, traits, functions and
//! the methods of impl blocks with where they are; contains, imports and
//! implements; and the calls it can resolve — a name a `use` brings, one of
//! the same module, `Self::`/`Type::` of a type of the crate, a method of a
//! field of `self` whose type is the crate's. A call it cannot resolve is
//! counted, never guessed: a wrong edge is worse than a missing one.
use std::collections::{BTreeSet, HashMap};
use std::fs;
use std::path::{Path, PathBuf};
use syn::spanned::Spanned;
use syn::visit::Visit;

const SKIP: [&str; 5] = ["target", ".git", ".gofi", "node_modules", "vendor"];

fn q(s: &str) -> String {
    let mut b = String::from("\"");
    for c in s.chars() {
        match c {
            '"' => b.push_str("\\\""),
            '\\' => b.push_str("\\\\"),
            '\n' => b.push_str("\\n"),
            '\r' => b.push_str("\\r"),
            '\t' => b.push_str("\\t"),
            c if (c as u32) < 0x20 => b.push_str(&format!("\\u{:04x}", c as u32)),
            c => b.push(c),
        }
    }
    b.push('"');
    b
}

fn walk(dir: &Path, out: &mut Vec<PathBuf>) {
    let Ok(rd) = fs::read_dir(dir) else { return };
    let mut entries: Vec<_> = rd.flatten().map(|e| e.path()).collect();
    entries.sort();
    for p in entries {
        let name = p.file_name().and_then(|n| n.to_str()).unwrap_or("");
        if p.is_dir() {
            if !SKIP.contains(&name) && !name.starts_with('.') {
                walk(&p, out);
            }
        } else if name.ends_with(".rs") {
            out.push(p);
        }
    }
}

/// The module path of a file: src/lib.rs and src/main.rs are the crate,
/// src/a/mod.rs and src/a.rs are crate::a.
fn module_of(rel: &str) -> String {
    let rel = rel.strip_prefix("src/").unwrap_or(rel);
    let rel = rel.strip_suffix(".rs").unwrap_or(rel);
    let mut parts: Vec<&str> = rel.split('/').collect();
    if matches!(parts.last(), Some(&"mod") | Some(&"lib") | Some(&"main")) {
        parts.pop();
    }
    let mut m = String::from("crate");
    for p in parts {
        if !p.is_empty() {
            m.push_str("::");
            m.push_str(p);
        }
    }
    m
}

struct Out {
    nodes: Vec<String>,
    edges: Vec<String>,
    unresolved: usize,
}

impl Out {
    fn edge(&mut self, from: &str, to: &str, rel: &str, file: &str, line: usize, conf: f64) {
        self.edges.push(format!(
            "{{\"rec\":\"edge\",\"from\":{},\"to\":{},\"rel\":{},\"file\":{},\"line\":{},\"conf\":{}}}",
            q(from), q(to), q(rel), q(file), line, conf
        ));
    }
}

fn vis(v: &syn::Visibility) -> &'static str {
    match v {
        syn::Visibility::Public(_) => "public",
        syn::Visibility::Restricted(_) => "package",
        syn::Visibility::Inherited => "private",
    }
}

fn last_ident(path: &syn::Path) -> String {
    path.segments.last().map(|s| s.ident.to_string()).unwrap_or_default()
}

fn type_name(ty: &syn::Type) -> Option<String> {
    match ty {
        syn::Type::Path(tp) => Some(last_ident(&tp.path)),
        syn::Type::Reference(r) => type_name(&r.elem),
        _ => None,
    }
}

/// What the names of a file stand for: what its `use`s bring, as full paths.
fn uses(tree: &syn::UseTree, prefix: &str, out: &mut HashMap<String, String>, mods: &mut BTreeSet<String>) {
    match tree {
        syn::UseTree::Path(p) => {
            let seg = p.ident.to_string();
            let next = if prefix.is_empty() { seg } else { format!("{prefix}::{seg}") };
            uses(&p.tree, &next, out, mods);
        }
        syn::UseTree::Name(n) => {
            let name = n.ident.to_string();
            if name == "self" {
                if let Some(last) = prefix.rsplit("::").next() {
                    out.insert(last.to_string(), prefix.to_string());
                }
            } else {
                out.insert(name.clone(), format!("{prefix}::{name}"));
            }
            mods.insert(prefix.to_string());
        }
        syn::UseTree::Rename(r) => {
            out.insert(r.rename.to_string(), format!("{prefix}::{}", r.ident));
            mods.insert(prefix.to_string());
        }
        syn::UseTree::Glob(_) => {
            mods.insert(prefix.to_string());
        }
        syn::UseTree::Group(g) => {
            for t in &g.items {
                uses(t, prefix, out, mods);
            }
        }
    }
}

struct Calls<'a> {
    from: String,
    module: String,
    owner: Option<String>,
    fields: &'a HashMap<String, String>,
    alias: &'a HashMap<String, String>,
    items: &'a BTreeSet<String>,
    file: &'a str,
    found: Vec<(String, usize)>,
    unresolved: usize,
}

impl<'a> Calls<'a> {
    /// The id of a path the crate defines, or None.
    fn resolve(&self, path: &[String]) -> Option<String> {
        if path.is_empty() {
            return None;
        }
        let mut full: Vec<String> = path.to_vec();
        if full[0] == "Self" {
            let owner = self.owner.as_ref()?;
            full[0] = owner.clone();
        }
        // A path that is already the crate's — a field's type, Self — is
        // the id itself.
        if full[0] == "crate" || full[0].starts_with("crate::") {
            let id = full.join("::");
            return self.items.contains(&id).then_some(id);
        }
        if full[0] == "self" {
            full[0] = self.module.clone();
            let id = full.join("::");
            return self.items.contains(&id).then_some(id);
        }
        if let Some(a) = self.alias.get(&full[0]) {
            let mut id = a.clone();
            for s in &full[1..] {
                id.push_str("::");
                id.push_str(s);
            }
            if self.items.contains(&id) {
                return Some(id);
            }
        }
        let id = format!("{}::{}", self.module, full.join("::"));
        self.items.contains(&id).then_some(id)
    }
}

impl<'a, 'ast> Visit<'ast> for Calls<'a> {
    fn visit_expr_call(&mut self, c: &'ast syn::ExprCall) {
        if let syn::Expr::Path(p) = &*c.func {
            let segs: Vec<String> = p.path.segments.iter().map(|s| s.ident.to_string()).collect();
            match self.resolve(&segs) {
                Some(to) => self.found.push((to, c.span().start().line)),
                None => self.unresolved += 1,
            }
        }
        syn::visit::visit_expr_call(self, c);
    }
    fn visit_expr_method_call(&mut self, m: &'ast syn::ExprMethodCall) {
        let name = m.method.to_string();
        let mut to = None;
        if let syn::Expr::Field(f) = &*m.receiver {
            if let (syn::Expr::Path(base), syn::Member::Named(field)) = (&*f.base, &f.member) {
                if base.path.is_ident("self") {
                    if let Some(ty) = self.fields.get(&field.to_string()) {
                        to = self.resolve(&[ty.clone(), name.clone()]);
                    }
                }
            }
        } else if let syn::Expr::Path(base) = &*m.receiver {
            if base.path.is_ident("self") {
                if let Some(owner) = &self.owner {
                    to = self.resolve(&[owner.clone(), name.clone()]);
                }
            }
        }
        match to {
            Some(to) => self.found.push((to, m.span().start().line)),
            None => self.unresolved += 1,
        }
        syn::visit::visit_expr_method_call(self, m);
    }
}

fn main() {
    let args: Vec<String> = std::env::args().collect();
    let mut root = PathBuf::from(".");
    for i in 0..args.len().saturating_sub(1) {
        if args[i] == "--root" {
            root = PathBuf::from(&args[i + 1]);
        }
    }
    let root = fs::canonicalize(&root).unwrap_or(root);
    let mut files = Vec::new();
    walk(&root, &mut files);
    println!(
        "{{\"rec\":\"header\",\"schema\":\"gofi-graph/v1\",\"language\":\"rust\",\"module\":{},\"tool\":\"gofi-graph-rust 0.1.0\",\"mode\":\"fast\"}}",
        q(root.file_name().and_then(|n| n.to_str()).unwrap_or("crate"))
    );
    // Read every file, and what the crate defines: the ids a path can name.
    let mut parsed = Vec::new();
    let mut items = BTreeSet::new();
    let mut loc = 0;
    let mut out = Out { nodes: Vec::new(), edges: Vec::new(), unresolved: 0 };
    for p in &files {
        let rel = p.strip_prefix(&root).unwrap_or(p).to_string_lossy().replace('\\', "/");
        let Ok(src) = fs::read_to_string(p) else { continue };
        loc += src.lines().count();
        match syn::parse_file(&src) {
            Ok(f) => {
                let m = module_of(&rel);
                items.insert(m.clone());
                for it in &f.items {
                    match it {
                        syn::Item::Fn(x) => { items.insert(format!("{m}::{}", x.sig.ident)); }
                        syn::Item::Struct(x) => { items.insert(format!("{m}::{}", x.ident)); }
                        syn::Item::Enum(x) => { items.insert(format!("{m}::{}", x.ident)); }
                        syn::Item::Trait(x) => { items.insert(format!("{m}::{}", x.ident)); }
                        syn::Item::Impl(x) => {
                            if let Some(ty) = type_name(&x.self_ty) {
                                for ii in &x.items {
                                    if let syn::ImplItem::Fn(f) = ii {
                                        items.insert(format!("{m}::{ty}::{}", f.sig.ident));
                                    }
                                }
                            }
                        }
                        _ => {}
                    }
                }
                parsed.push((rel, m, f));
            }
            Err(e) => out.nodes.push(format!("{{\"rec\":\"diag\",\"severity\":\"warn\",\"msg\":{}}}", q(&format!("{rel}: not read: {e}")))),
        }
    }
    for (rel, m, f) in &parsed {
        let mid = format!("rust:{m}");
        let lines = fs::read_to_string(root.join(rel)).map(|s| s.lines().count()).unwrap_or(1);
        out.nodes.push(format!("{{\"rec\":\"node\",\"id\":{},\"kind\":\"module\",\"name\":{},\"file\":{},\"line\":1,\"lines\":{}}}", q(&mid), q(m), q(rel), lines.max(1)));
        let mut alias = HashMap::new();
        let mut used = BTreeSet::new();
        for it in &f.items {
            if let syn::Item::Use(u) = it {
                let line = u.span().start().line;
                let mut mods = BTreeSet::new();
                uses(&u.tree, "", &mut alias, &mut mods);
                for md in mods {
                    if used.insert(md.clone()) {
                        let first = md.split("::").next().unwrap_or("");
                        let to = if first == "crate" || first == "self" || first == "super" {
                            let md = if first == "self" { md.replacen("self", m, 1) } else { md.clone() };
                            // A use of an item names the module that holds it.
                            if items.contains(&md) { format!("rust:{md}") } else { format!("rust:{}", md.rsplit_once("::").map(|(a, _)| a).unwrap_or(&md)) }
                        } else {
                            format!("pkg:{first}")
                        };
                        out.edge(&mid, &to, "imports", rel, line, 1.0);
                    }
                }
            }
        }
        // The types of the fields of each struct: what self.field is.
        let mut fields_of: HashMap<String, HashMap<String, String>> = HashMap::new();
        for it in &f.items {
            if let syn::Item::Struct(s) = it {
                let mut fm = HashMap::new();
                for fd in &s.fields {
                    if let (Some(id), Some(ty)) = (&fd.ident, type_name(&fd.ty)) {
                        let full = alias.get(&ty).cloned().unwrap_or_else(|| format!("{m}::{ty}"));
                        fm.insert(id.to_string(), full);
                    }
                }
                fields_of.insert(s.ident.to_string(), fm);
            }
        }
        let empty = HashMap::new();
        let node = |out: &mut Out, id: &str, kind: &str, name: &str, owner: &str, span: proc_macro2::Span, v: &str, sig: &str| {
            let (s, e) = (span.start().line, span.end().line);
            out.nodes.push(format!(
                "{{\"rec\":\"node\",\"id\":{},\"kind\":{},\"name\":{},\"unit\":{},\"owner\":{},\"file\":{},\"line\":{},\"lines\":{},\"vis\":{},\"sig\":{}}}",
                q(id), q(kind), q(name), q(&mid), q(owner), q(rel), s, e.saturating_sub(s) + 1, q(v), q(sig)
            ));
            out.edge(&mid, id, "contains", rel, s, 1.0);
        };
        let calls = |out: &mut Out, from: &str, owner: Option<String>, fields: &HashMap<String, String>, block: &syn::Block| {
            let mut c = Calls { from: from.to_string(), module: m.clone(), owner, fields, alias: &alias, items: &items, file: rel, found: Vec::new(), unresolved: 0 };
            c.visit_block(block);
            out.unresolved += c.unresolved;
            for (to, line) in c.found {
                out.edge(&c.from, &format!("rust:{to}"), "calls", c.file, line, 0.9);
            }
        };
        for it in &f.items {
            match it {
                syn::Item::Fn(x) => {
                    let id = format!("rust:{m}::{}", x.sig.ident);
                    node(&mut out, &id, "func", &x.sig.ident.to_string(), "", x.span(), vis(&x.vis), &format!("fn {}", x.sig.ident));
                    calls(&mut out, &id, None, &empty, &x.block);
                }
                syn::Item::Struct(x) => node(&mut out, &format!("rust:{m}::{}", x.ident), "struct", &x.ident.to_string(), "", x.span(), vis(&x.vis), &format!("struct {}", x.ident)),
                syn::Item::Enum(x) => node(&mut out, &format!("rust:{m}::{}", x.ident), "enum", &x.ident.to_string(), "", x.span(), vis(&x.vis), &format!("enum {}", x.ident)),
                syn::Item::Trait(x) => node(&mut out, &format!("rust:{m}::{}", x.ident), "trait", &x.ident.to_string(), "", x.span(), vis(&x.vis), &format!("trait {}", x.ident)),
                syn::Item::Impl(x) => {
                    let Some(ty) = type_name(&x.self_ty) else { continue };
                    let tid = format!("{m}::{ty}");
                    if let Some((_, tr, _)) = &x.trait_ {
                        let name = last_ident(tr);
                        let to = alias.get(&name).cloned().unwrap_or_else(|| format!("{m}::{name}"));
                        if items.contains(&to) {
                            out.edge(&format!("rust:{tid}"), &format!("rust:{to}"), "implements", rel, x.span().start().line, 0.9);
                        }
                    }
                    let fields = fields_of.get(&ty).unwrap_or(&empty);
                    for ii in &x.items {
                        if let syn::ImplItem::Fn(fnc) = ii {
                            let id = format!("rust:{tid}::{}", fnc.sig.ident);
                            node(&mut out, &id, "method", &fnc.sig.ident.to_string(), &ty, fnc.span(), vis(&fnc.vis), &format!("fn {}", fnc.sig.ident));
                            calls(&mut out, &id, Some(tid.clone()), fields, &fnc.block);
                        }
                    }
                }
                _ => {}
            }
        }
    }
    for n in &out.nodes {
        println!("{n}");
    }
    for e in &out.edges {
        println!("{e}");
    }
    println!("{{\"rec\":\"summary\",\"files\":{},\"loc\":{},\"unresolved\":{},\"ambiguous\":0}}", parsed.len(), loc, out.unresolved);
}
