#!/bin/sh
# gofi-graph-java: the code graph of a Java tree, in gofi's extractor
# protocol. The program is the Java source below, run by the JDK's source
# launcher (Java 11+) with the JDK's own parser: nothing to download. It is
# written to the user's cache, by its hash, the first time it runs.
set -e
run="${XDG_CACHE_HOME:-$HOME/.cache}/gofi/extractors/java-20ef50876a0a"
if [ ! -f "$run/GofiGraphJava.java" ]; then
  mkdir -p "$run"
  sed '1,/^__JAVA__$/d' "$0" > "$run/GofiGraphJava.java.$$"
  mv "$run/GofiGraphJava.java.$$" "$run/GofiGraphJava.java"
fi
exec java "$run/GofiGraphJava.java" "$@"
__JAVA__
import com.sun.source.tree.*;
import com.sun.source.util.*;
import javax.tools.*;
import java.io.*;
import java.nio.charset.StandardCharsets;
import java.nio.file.*;
import java.util.*;
import java.util.stream.*;

/**
 * gofi-graph-java: the code graph of a Java tree, in gofi's extractor
 * protocol (gofi-graph/v1), one JSON record a line on stdout.
 *
 * Reads the tree with the JDK's own parser (com.sun.source), with no
 * classpath: each package, type and method with where it is; contains,
 * imports, extends and implements; and the calls it can resolve — a method
 * of the same type, or of a field, parameter or local of a type of the
 * project, or static by a type's name. A call it cannot resolve is counted,
 * never guessed: a wrong edge is worse than a missing one.
 */
public class GofiGraphJava {
    static final String TOOL = "gofi-graph-java 0.1.0";
    static final Set<String> SKIP = Set.of(".git", "target", "build", "node_modules", ".gofi", ".idea", ".mvn", "out");
    static final StringBuilder edges = new StringBuilder();
    static int unresolved = 0;

    static String q(String s) {
        StringBuilder b = new StringBuilder("\"");
        for (char c : (s == null ? "" : s).toCharArray()) {
            switch (c) {
                case '"' -> b.append("\\\"");
                case '\\' -> b.append("\\\\");
                case '\n' -> b.append("\\n");
                case '\r' -> b.append("\\r");
                case '\t' -> b.append("\\t");
                default -> { if (c < 0x20) b.append(String.format("\\u%04x", (int) c)); else b.append(c); }
            }
        }
        return b.append('"').toString();
    }

    static void emit(String json) { System.out.println(json); }

    static void edge(String from, String to, String rel, String file, long line, double conf) {
        edges.append("{\"rec\":\"edge\",\"from\":").append(q(from)).append(",\"to\":").append(q(to))
            .append(",\"rel\":").append(q(rel)).append(",\"file\":").append(q(file)).append(",\"line\":").append(line)
            .append(",\"conf\":").append(conf).append("}\n");
    }

    public static void main(String[] args) throws IOException {
        String root = ".";
        for (int i = 0; i + 1 < args.length; i++) if (args[i].equals("--root")) root = args[i + 1];
        Path base = Paths.get(root).toAbsolutePath().normalize();
        List<Path> files;
        try (Stream<Path> s = Files.walk(base)) {
            files = s.filter(p -> p.toString().endsWith(".java"))
                .filter(p -> { for (Path part : base.relativize(p)) if (SKIP.contains(part.toString())) return false; return true; })
                .sorted().collect(Collectors.toList());
        }
        emit("{\"rec\":\"header\",\"schema\":\"gofi-graph/v1\",\"language\":\"java\",\"module\":" + q(base.getFileName().toString())
            + ",\"tool\":" + q(TOOL) + ",\"mode\":\"fast\"}");
        JavaCompiler javac = ToolProvider.getSystemJavaCompiler();
        StandardJavaFileManager fm = javac.getStandardFileManager(null, null, StandardCharsets.UTF_8);
        JavacTask task = (JavacTask) javac.getTask(null, fm, d -> {}, List.of("-proc:none"), null, fm.getJavaFileObjectsFromPaths(files));
        List<CompilationUnitTree> units = new ArrayList<>();
        for (CompilationUnitTree u : task.parse()) units.add(u);
        SourcePositions pos = Trees.instance(task).getSourcePositions();

        // Every type of the project, by its simple name per package: what a
        // name in a file can resolve to.
        Map<String, String> typeIds = new HashMap<>(); // fqn -> id
        Set<String> packages = new TreeSet<>();
        for (CompilationUnitTree u : units) {
            String pkg = u.getPackageName() == null ? "" : u.getPackageName().toString();
            packages.add(pkg);
            for (Tree t : u.getTypeDecls()) if (t instanceof ClassTree c) {
                String fqn = pkg.isEmpty() ? c.getSimpleName().toString() : pkg + "." + c.getSimpleName();
                typeIds.put(fqn, "java:" + fqn);
            }
        }
        long loc = 0;
        Set<String> emittedPkgs = new HashSet<>();
        for (CompilationUnitTree u : units) {
            String file = base.relativize(Paths.get(u.getSourceFile().toUri())).toString().replace(File.separatorChar, '/');
            String pkg = u.getPackageName() == null ? "" : u.getPackageName().toString();
            String pid = "java:" + pkg;
            LineMap lm = u.getLineMap();
            String src = u.getSourceFile().getCharContent(true).toString();
            loc += src.chars().filter(ch -> ch == '\n').count() + 1;
            if (emittedPkgs.add(pkg)) {
                emit("{\"rec\":\"node\",\"id\":" + q(pid) + ",\"kind\":\"package\",\"name\":" + q(pkg) + ",\"file\":" + q(file) + ",\"line\":1}");
            }
            // The names this file can say: its imports, its package's types.
            Map<String, String> names = new HashMap<>();
            for (Map.Entry<String, String> e : typeIds.entrySet()) {
                String fqn = e.getKey();
                int dot = fqn.lastIndexOf('.');
                if ((dot < 0 ? "" : fqn.substring(0, dot)).equals(pkg)) names.put(fqn.substring(dot + 1), e.getValue());
            }
            for (ImportTree im : u.getImports()) {
                String name = im.getQualifiedIdentifier().toString();
                long line = lm.getLineNumber(pos.getStartPosition(u, im));
                if (name.endsWith(".*")) {
                    String p = name.substring(0, name.length() - 2);
                    edge(pid, packages.contains(p) ? "java:" + p : "pkg:" + p, "imports", file, line, 1);
                    for (Map.Entry<String, String> e : typeIds.entrySet())
                        if (e.getKey().startsWith(p + ".") && e.getKey().indexOf('.', p.length() + 1) < 0)
                            names.put(e.getKey().substring(p.length() + 1), e.getValue());
                    continue;
                }
                int dot = name.lastIndexOf('.');
                String p = dot < 0 ? name : name.substring(0, dot);
                if (typeIds.containsKey(name)) {
                    names.put(name.substring(dot + 1), typeIds.get(name));
                    edge(pid, "java:" + p, "imports", file, line, 1);
                } else {
                    edge(pid, "pkg:" + p, "imports", file, line, 1);
                }
            }
            for (Tree t : u.getTypeDecls()) {
                if (!(t instanceof ClassTree c)) continue;
                String cname = c.getSimpleName().toString();
                String cid = names.getOrDefault(cname, "java:" + (pkg.isEmpty() ? cname : pkg + "." + cname));
                long start = lm.getLineNumber(pos.getStartPosition(u, c));
                long end = lm.getLineNumber(pos.getEndPosition(u, c));
                String kind = switch (c.getKind()) {
                    case INTERFACE, ANNOTATION_TYPE -> "interface";
                    case ENUM -> "enum";
                    default -> "class";
                };
                emit("{\"rec\":\"node\",\"id\":" + q(cid) + ",\"kind\":" + q(kind) + ",\"name\":" + q(cname) + ",\"unit\":" + q(pid)
                    + ",\"file\":" + q(file) + ",\"line\":" + start + ",\"lines\":" + (end - start + 1) + ",\"vis\":" + q(vis(c.getModifiers()))
                    + ",\"sig\":" + q(kind + " " + cname) + "}");
                edge(pid, cid, "contains", file, start, 1);
                if (c.getExtendsClause() != null) relate(cid, c.getExtendsClause(), names, "extends", file, start);
                for (Tree i : c.getImplementsClause()) relate(cid, i, names, "implements", file, start);
                // What a name in the type's methods is: its fields first.
                Map<String, String> fields = new HashMap<>();
                for (Tree m : c.getMembers())
                    if (m instanceof VariableTree v) {
                        String ty = typeOf(v.getType(), names);
                        if (ty != null) fields.put(v.getName().toString(), ty);
                    }
                for (Tree m : c.getMembers()) {
                    if (!(m instanceof MethodTree mt)) continue;
                    String mname = mt.getName().toString().equals("<init>") ? cname : mt.getName().toString();
                    String mid = cid + "#" + mname;
                    long ms = lm.getLineNumber(pos.getStartPosition(u, mt));
                    long me = lm.getLineNumber(pos.getEndPosition(u, mt));
                    String params = mt.getParameters().stream().map(p -> p.getType() + " " + p.getName()).collect(Collectors.joining(", "));
                    emit("{\"rec\":\"node\",\"id\":" + q(mid) + ",\"kind\":\"method\",\"name\":" + q(mname) + ",\"unit\":" + q(pid)
                        + ",\"owner\":" + q(cname) + ",\"file\":" + q(file) + ",\"line\":" + ms + ",\"lines\":" + (me - ms + 1)
                        + ",\"vis\":" + q(vis(mt.getModifiers())) + ",\"sig\":" + q(mname + "(" + params + ")") + "}");
                    edge(pid, mid, "contains", file, ms, 1);
                    Map<String, String> scope = new HashMap<>(fields);
                    for (VariableTree p : mt.getParameters()) {
                        String ty = typeOf(p.getType(), names);
                        if (ty != null) scope.put(p.getName().toString(), ty);
                    }
                    if (mt.getBody() != null) calls(mt.getBody(), mid, cid, scope, names, u, lm, pos, file);
                }
            }
        }
        System.out.print(edges);
        emit("{\"rec\":\"summary\",\"files\":" + units.size() + ",\"loc\":" + loc + ",\"unresolved\":" + unresolved + ",\"ambiguous\":0}");
    }

    static String vis(ModifiersTree m) {
        String f = m.getFlags().toString();
        if (f.contains("PUBLIC")) return "public";
        if (f.contains("PROTECTED")) return "protected";
        if (f.contains("PRIVATE")) return "private";
        return "package";
    }

    static String typeOf(Tree type, Map<String, String> names) {
        if (type == null) return null;
        String t = type.toString();
        int lt = t.indexOf('<');
        if (lt >= 0) t = t.substring(0, lt);
        return names.get(t);
    }

    static void relate(String from, Tree type, Map<String, String> names, String rel, String file, long line) {
        String to = typeOf(type, names);
        if (to != null) edge(from, to, rel, file, line, 0.9);
    }

    static void calls(BlockTree body, String mid, String cid, Map<String, String> scope, Map<String, String> names,
                      CompilationUnitTree u, LineMap lm, SourcePositions pos, String file) {
        new TreeScanner<Void, Void>() {
            @Override public Void visitVariable(VariableTree v, Void x) {
                String ty = typeOf(v.getType(), names);
                if (ty != null) scope.put(v.getName().toString(), ty);
                return super.visitVariable(v, x);
            }
            @Override public Void visitMethodInvocation(MethodInvocationTree mi, Void x) {
                long line = lm.getLineNumber(pos.getStartPosition(u, mi));
                ExpressionTree sel = mi.getMethodSelect();
                String to = null;
                if (sel instanceof IdentifierTree id) {
                    to = cid + "#" + id.getName();
                } else if (sel instanceof MemberSelectTree ms) {
                    ExpressionTree recv = ms.getExpression();
                    String name = ms.getIdentifier().toString();
                    String r = recv.toString();
                    if (r.startsWith("this.")) r = r.substring(5);
                    if (r.equals("this")) to = cid + "#" + name;
                    else if (scope.containsKey(r)) to = scope.get(r) + "#" + name;
                    else if (names.containsKey(r)) to = names.get(r) + "#" + name;
                }
                if (to != null) edge(mid, to, "calls", file, line, 0.9);
                else unresolved++;
                return super.visitMethodInvocation(mi, x);
            }
            @Override public Void visitNewClass(NewClassTree nc, Void x) {
                String ty = typeOf(nc.getIdentifier(), names);
                if (ty != null) edge(mid, ty + "#" + ty.substring(ty.lastIndexOf('.') + 1), "calls", file, lm.getLineNumber(pos.getStartPosition(u, nc)), 0.9);
                return super.visitNewClass(nc, x);
            }
        }.scan(body, null);
    }
}
