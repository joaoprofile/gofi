package service

import "testing"

// gofi:tests REQ-01.1
func TestReembolsoDescontaATaxa(t *testing.T) {
	got, err := Reembolso(10000, 5)
	if err != nil || got != 9700 {
		t.Fatalf("Reembolso(10000, 5) = %d, %v", got, err)
	}
}

