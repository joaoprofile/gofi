# .gofi.yaml — configuração do projeto (gerado por `gofi init`)
#
# Fonte única das escolhas do projeto. Toda skill lê este arquivo ANTES de
# qualquer coisa para descobrir a linguagem do backend, o nome do projeto, as
# superfícies de UI e a stack de plataforma.
#
# Este template é a REFERÊNCIA do schema v2 — o arquivo real é escrito pela CLI
# (internal/config: Save → yaml.Marshal), não por renderização deste .tmpl.
# Campos marcados {{ "{{ ... }}" }} correspondem 1:1 aos campos de config.GofiConfig.
version: 2

# Identidade do projeto. Language e layout de código saíram daqui na v2 —
# moraram para os blocos backend: / frontend: / mobile:.
project:
    name: {{.Project.Name}}                 # slug; resolve a pasta institucional
    root: {{.Project.Root}}                 # raiz absoluta do workspace

# ───────────────────────────────────────────────────────────────────────────
# BACKEND — omitir o bloco inteiro num projeto front-only
# ───────────────────────────────────────────────────────────────────────────
{{- if .Backend}}
backend:
    language: {{.Backend.Language}}         # go|rust|java|csharp|python|nodejs → define sdk/<lang>/
    path: {{.Backend.Path}}                 # pasta do código, relativa a project.root
{{- end}}

# ───────────────────────────────────────────────────────────────────────────
# SUPERFÍCIES DE UI — consumidas por /gofi-ui. Cada uma é um bloco de topo:
# `frontend:` (web) e `mobile:`. Omitir a que o projeto não tem.
#
# Só framework e path são validados. brand, styling, state, forms, i18n,
# testing, ds e legacy são livres: `gofi init` semeia os presets gofi, e um
# projeto com design system próprio escreve os seus valores aqui.
# ───────────────────────────────────────────────────────────────────────────
{{- if .Frontend}}
frontend:
    framework: {{.Frontend.Framework}}      # react|angular|vue
    path: {{.Frontend.Path}}                # raiz do app, relativa a project.root
    brand: {{.Frontend.Brand}}              # preset gofi (blue|violet|green) ou marca do projeto
    styling: {{.Frontend.Styling}}          # tailwind | scss-modules | css-modules | ...
    state: {{.Frontend.State}}              # camada de data/estado (tanstack-query, axios-hooks, ...)
{{- if .Frontend.Forms}}
    forms: {{.Frontend.Forms}}              # react-hook-form | react-final-form | formik | ...
{{- end}}
{{- if .Frontend.I18n}}
    i18n: {{.Frontend.I18n}}                # react-i18next | lingui | ... (ex.: pt/en/es)
{{- end}}
    testing: {{.Frontend.Testing}}          # vitest | jest (+ testing-library)
{{- if .Frontend.DS}}
    ds: {{.Frontend.DS}}                    # design system: gofi-ui ou pacote próprio
{{- end}}
{{- if .Frontend.Legacy}}
    legacy: {{.Frontend.Legacy}}            # stack em migração — gofi-ui trata como código a substituir
{{- end}}
{{- else}}
# frontend:
#     framework: react
#     path: frontend
#     brand: blue
#     styling: tailwind
#     state: tanstack-query
#     testing: vitest
#     ds: gofi-ui
{{- end}}
{{- if .Mobile}}
mobile:
    framework: {{.Mobile.Framework}}        # react-native|expo
    path: {{.Mobile.Path}}
    brand: {{.Mobile.Brand}}
    styling: {{.Mobile.Styling}}            # stylesheet | nativewind | ...
    state: {{.Mobile.State}}
{{- if .Mobile.Forms}}
    forms: {{.Mobile.Forms}}
{{- end}}
{{- if .Mobile.I18n}}
    i18n: {{.Mobile.I18n}}
{{- end}}
    testing: {{.Mobile.Testing}}            # jest (+ react-native-testing-library)
{{- if .Mobile.DS}}
    ds: {{.Mobile.DS}}                      # gofi-ui-native ou pacote próprio
{{- end}}
{{- if .Mobile.Legacy}}
    legacy: {{.Mobile.Legacy}}
{{- end}}
{{- else}}
# mobile:
#     framework: react-native
#     path: mobile
#     brand: blue
#     styling: stylesheet
#     state: tanstack-query
#     testing: jest
#     ds: gofi-ui-native
{{- end}}

# ───────────────────────────────────────────────────────────────────────────
# CAMADA OPS — consumida por /gofi-ops (omitir o bloco se não há IaC/CI-CD)
# ───────────────────────────────────────────────────────────────────────────
{{- if .Ops}}
ops:
    cloud: {{.Ops.Cloud}}                   # oci | aws | gcp | azure
    iac: {{.Ops.IaC}}                       # terraform | opentofu | pulumi
    target: {{.Ops.Target}}                 # k8s | oke | eks | gke | swarm | container-instances | paas
    cicd: {{.Ops.CICD}}                     # github-actions | azure-devops | gitlab-ci | oci-devops
    registry: {{.Ops.Registry}}             # ocir | ecr | gar | acr
    path: {{.Ops.Path}}                     # pasta guarda-chuva na raiz (iac/ deploy/ ci/ pipelines/)
{{- else}}
# ops:
#     cloud: oci
#     iac: terraform
#     target: oke
#     cicd: github-actions
#     registry: ocir
#     path: ops
{{- end}}

ai:
    host: {{.AI.Host}}                      # claude-vscode
    model: {{.AI.Model}}                    # claude-opus-4-8 | claude-opus-4-7 | claude-sonnet-4-6 | claude-haiku-4-5

# Agents habilitados. Skills são sempre instaladas em .claude/skills/; esta
# lista escopa os diretórios .claude/knowledge/{agent}/.
agents:
{{- range .Agents}}
    - {{.}}
{{- end}}

sources:
    agents: {{.Sources.Agents}}             # repo-fonte do harness (skills, sdk-docs, knowledge)
{{- if .Sources.Institutional}}
    institutional: {{.Sources.Institutional}} # repo de conhecimento institucional (pull-only)
{{- end}}
{{- if .Sources.SDK}}
    sdk:
{{- range $lang, $ref := .Sources.SDK}}
        {{$lang}}: {{$ref}}                 # checkout do SDK da linguagem (via go.work)
{{- end}}
{{- end}}
{{- if .Sources.UI}}
    ui:
{{- range $ds, $ref := .Sources.UI}}
        {{$ds}}: {{$ref}}                   # override do repo do design system
{{- end}}
{{- end}}

git:
    remote: "{{.Git.Remote}}"

# ───────────────────────────────────────────────────────────────────────────
# TEST — tasks rodadas por `gofi test [task]`. `needs` encadeia dependências.
# ───────────────────────────────────────────────────────────────────────────
test:
    default: {{.Test.Default}}              # task rodada por `gofi test` sem argumento
    hooks:
        pre: []
        post: []
    tasks:
{{- range $name, $task := .Test.Tasks}}
        {{$name}}:
            desc: {{$task.Desc}}
            run: {{$task.Run}}
{{- if $task.Needs}}
            needs:
{{- range $task.Needs}}
                - {{.}}
{{- end}}
{{- end}}
{{- end}}

# ───────────────────────────────────────────────────────────────────────────
# HSEC — SAST via Horusec (`gofi hsec`). Renderizado em .gofi/horusec-config.json.
# ───────────────────────────────────────────────────────────────────────────
hsec:
    enabled: {{.Hsec.Enabled}}
    ignore_paths:
{{- range .Hsec.IgnorePaths}}
        - '{{.}}'
{{- end}}
    severity_threshold: {{.Hsec.SeverityThreshold}}   # CRITICAL | HIGH | MEDIUM | LOW
    return_error_on_finding: {{.Hsec.ReturnErrorOnFinding}}
    output_format: {{.Hsec.OutputFormat}}             # text | json | sarif
{{- if .Hsec.OutputFile}}
    output_file: {{.Hsec.OutputFile}}
{{- end}}
    timeout_seconds: {{.Hsec.TimeoutSeconds}}

# ───────────────────────────────────────────────────────────────────────────
# SONAR — análise estática (`gofi sonar`). Renderizado em
# .gofi/sonar-project.properties a cada execução. SONAR_HOST_URL e SONAR_TOKEN
# vêm do ambiente (.env) e NUNCA são gravados aqui.
# ───────────────────────────────────────────────────────────────────────────
sonar:
    enabled: {{.Sonar.Enabled}}
    project_key: {{.Sonar.ProjectKey}}
    project_name: {{.Sonar.ProjectName}}
{{- if .Sonar.HostURL}}
    host_url: {{.Sonar.HostURL}}            # override não-secreto do servidor (opcional)
{{- end}}
    sources:                                 # pastas de código próprio (backend/frontend/mobile)
{{- range .Sonar.Sources}}
        - {{.}}
{{- end}}
    exclusions:                              # testes, mocks, gerados, vendored e artefatos de build
{{- range .Sonar.Exclusions}}
        - '{{.}}'
{{- end}}
{{- if .Sonar.CoverageReport}}
    coverage_report: {{.Sonar.CoverageReport}}   # artefato produzido pela task `cover`
{{- end}}
